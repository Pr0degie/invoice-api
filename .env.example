# ── Database ──────────────────────────────────────────────────────────────────
# Railway injects DATABASE_URL automatically when a Postgres service is linked.
# Alternatively set the Npgsql connection string directly:
DATABASE_URL=postgres://user:pass@host:5432/invoiceapi
# ConnectionStrings__Default=Host=...;Port=5432;Database=invoiceapi;Username=...;Password=...

# TLS certificate validation for the DATABASE_URL connection. Default: false
# (certificates ARE validated — the secure mode). Set to true only if the
# Postgres server presents a certificate that cannot be validated, e.g.
# Railway-internal connections (*.railway.internal) with self-signed certs.
# Database__TrustServerCertificate=false

# ── JWT ───────────────────────────────────────────────────────────────────────
Jwt__SigningKey=<generate with: openssl rand -base64 48>
Jwt__Issuer=invoice-api
Jwt__Audience=invoiceflow
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# Exact origins allowed. Vercel preview URLs (invoiceflow-*.vercel.app) are
# whitelisted via code pattern — no wildcard entry needed here.
Cors__AllowedOrigins__0=https://invoiceflow.yourdomain.com

# ── Frontend base URL ─────────────────────────────────────────────────────────
# Used to build the links in reset-password / verify-email e-mails:
#   {FRONTEND_BASE_URL}/{locale}/reset-password?token=...   and   /verify-email
# Defaults to http://localhost:3000 when unset. With Email__Provider=Smtp the
# startup validation requires a public (non-localhost) URL in Production.
FRONTEND_BASE_URL=https://invoiceflow.yourdomain.com

# ── E-mail ────────────────────────────────────────────────────────────────────
# Development needs NOTHING here: without Email__Provider=Smtp the API uses the
# log-only sender, which writes each mail (incl. the link) to the log.
# PRODUCTION requires an explicit choice — Email__Provider=Smtp (real mail) or
# Email__Provider=Log (demo/log-only) — otherwise the API refuses to start.
# With Smtp, Host + FromAddress are required and User/Password must be set
# together; an incomplete config fails at startup instead of dropping mail.
# Email__Provider=Smtp
# Email__Smtp__Host=smtp.yourprovider.com
# Email__Smtp__Port=587
# Email__Smtp__User=apikey-or-username
# Email__Smtp__Password=your-smtp-password
# Email__Smtp__UseStartTls=true
# Email__FromAddress=no-reply@invoiceflow.app
# Email__FromName=InvoiceFlow

# ── Seed ──────────────────────────────────────────────────────────────────────
# Set to true on first deploy to populate demo user + invoices.
# Safe to leave enabled — only runs when the users table is empty.
Seed__Enabled=true

# ── ASP.NET Core ──────────────────────────────────────────────────────────────
ASPNETCORE_URLS=http://0.0.0.0:8080
ASPNETCORE_ENVIRONMENT=Production

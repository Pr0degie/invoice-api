{
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=invoiceapi;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "invoice-api",
    "Audience": "invoiceflow",
    "SigningKey": "CHANGE_ME_IN_PRODUCTION_min_32_chars_long",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ],
    "PreviewOriginSuffix": ""
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:3000"
  },
  "Email": {
    "Provider": "Log",
    "FromAddress": "no-reply@invoiceflow.app",
    "FromName": "InvoiceFlow"
  },
  "Seed": {
    "Enabled": true
  },
  "RefreshTokenCleanup": {
    "Interval": "06:00:00",
    "Retention": "7.00:00:00"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
